#!/usr/bin/env bash
set -e

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Deterministic Pre-Commit Hook for Kids School Helpers
# Enforces sub-second code quality, syntax validation, and ast-grep guardrails on staged files.

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# Filter files, excluding third-party vendor code like pre-algebra-solver/lib/
STAGED_JS=$(echo "$STAGED_FILES" | grep -E '\.js$' | grep -v -E '(^|/)lib/' || true)
STAGED_ALL_CODE=$(echo "$STAGED_FILES" | grep -E '\.(js|html|css|json|md)$' || true)

echo "🔍 Running pre-commit validation gates on staged files..."

# 1. Merge Conflict Marker Check
if [ -n "$STAGED_ALL_CODE" ]; then
    echo "  ▶ [1/5] Checking for merge conflict markers..."
    CONFLICTS=$(git diff --cached --check || true)
    if [ -n "$CONFLICTS" ]; then
        echo "❌ Merge conflict markers or whitespace errors detected:"
        echo "$CONFLICTS"
        exit 1
    fi
fi

# 2. JavaScript Syntax Verification (node -c)
if [ -n "$STAGED_JS" ]; then
    echo "  ▶ [2/5] JavaScript syntax check (node -c)..."
    for file in $STAGED_JS; do
        if [ -f "$file" ]; then
            node -c "$file" || {
                echo "❌ JavaScript syntax error in $file"
                exit 1
            }
        fi
    done
    echo "    ✔ Syntax check passed cleanly."
fi

# 3. ast-grep Structural Rules Check
if [ -n "$STAGED_JS" ]; then
    echo "  ▶ [3/5] ast-grep structural coding rules..."
    if command -v ast-grep >/dev/null 2>&1; then
        ast-grep scan --min-severity error $STAGED_JS || {
            echo "❌ ast-grep rule violations detected. Fix errors before committing."
            exit 1
        }
        echo "    ✔ ast-grep scan clean (0 blocking errors)."
    else
        echo "    ℹ ast-grep not found in PATH; skipping ast-grep scan."
    fi
fi

# 4. ESLint Check (if available)
if [ -n "$STAGED_JS" ]; then
    if command -v eslint >/dev/null 2>&1 || [ -f "node_modules/.bin/eslint" ]; then
        echo "  ▶ [4/5] ESLint code quality scan..."
        npx eslint $STAGED_JS || {
            echo "❌ ESLint check failed. Fix lint issues or run 'npx eslint --fix'."
            exit 1
        }
        echo "    ✔ ESLint check passed."
    else
        echo "  ▶ [4/5] ESLint not installed in environment; syntax + ast-grep gates active."
    fi
else
    echo "  ▶ [4/5] No staged JavaScript files to lint."
fi

# 5. Staged Artifacts & Secrets Hygiene
echo "  ▶ [5/5] Hygiene & sensitive files check..."
SUSPICIOUS_FILES=$(echo "$STAGED_FILES" | grep -E '(\.env|debug-.*\.png$|\.server\.pid$|test-results\.json$)' || true)
if [ -n "$SUSPICIOUS_FILES" ]; then
    echo "⚠️ Warning: The following temporary/debug files are staged for commit:"
    echo "$SUSPICIOUS_FILES"
    echo "Please unstage or add them to .gitignore before committing."
    exit 1
fi

echo "✅ All pre-commit gates passed cleanly!"
exit 0
